# Aurora PostgreSQL Serverless v2, Multi-AZ (writer + reader in different AZs, automatic failover).
# Why a relational store: the money path needs multi-row ACID transactions, row-level locks
# (SELECT ... FOR UPDATE), unique constraints (idempotency) and triggers (append-only ledger).
# DynamoDB could model parts of it but would push all of that into application code.
# QLDB was the brief's suggestion but AWS ended support for it (July 2025), so the immutable ledger
# is implemented in SQL: append-only trigger + REVOKE UPDATE/DELETE + per-wallet SHA-256 hash chain.

resource "aws_db_subnet_group" "main" {
  name       = "${local.name}-db"
  subnet_ids = aws_subnet.data[*].id
}

resource "aws_rds_cluster_parameter_group" "main" {
  name   = "${local.name}-pg16"
  family = "aurora-postgresql16"
  parameter {
    name  = "rds.force_ssl" # reject any non-TLS connection: encryption in transit
    value = "1"
  }
  parameter {
    name         = "log_min_duration_statement"
    value        = "500"
    apply_method = "immediate"
  }
}

resource "aws_rds_cluster" "main" {
  cluster_identifier                  = "${local.name}-aurora"
  engine                              = "aurora-postgresql"
  engine_mode                         = "provisioned"
  engine_version                      = "16.4"
  database_name                       = "momo"
  master_username                     = "momo_admin"
  manage_master_user_password         = true # password generated by RDS and kept in Secrets Manager
  master_user_secret_kms_key_id       = aws_kms_key.data.arn
  iam_database_authentication_enabled = true
  storage_encrypted                   = true
  kms_key_id                          = aws_kms_key.data.arn
  db_subnet_group_name                = aws_db_subnet_group.main.name
  vpc_security_group_ids              = [aws_security_group.db.id]
  db_cluster_parameter_group_name     = aws_rds_cluster_parameter_group.main.name
  backup_retention_period             = 1
  preferred_backup_window             = "01:00-02:00"
  copy_tags_to_snapshot               = true
  deletion_protection                 = var.deletion_protection
  skip_final_snapshot                 = !var.deletion_protection
  final_snapshot_identifier           = var.deletion_protection ? "${local.name}-final" : null
  enabled_cloudwatch_logs_exports     = ["postgresql"]
  availability_zones                  = local.azs

  serverlessv2_scaling_configuration {
    min_capacity = var.aurora_min_acu
    max_capacity = var.aurora_max_acu
  }
}

resource "aws_rds_cluster_instance" "main" {
  count                           = 2 # one per AZ => Multi-AZ failover
  identifier                      = "${local.name}-aurora-${count.index}"
  cluster_identifier              = aws_rds_cluster.main.id
  instance_class                  = "db.serverless"
  engine                          = aws_rds_cluster.main.engine
  engine_version                  = aws_rds_cluster.main.engine_version
  availability_zone               = local.azs[count.index]
  performance_insights_enabled    = true
  performance_insights_kms_key_id = aws_kms_key.data.arn
  promotion_tier                  = count.index
}
